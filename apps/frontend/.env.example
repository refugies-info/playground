# Supabase Configuration Template
# Copy this file to .env.local and fill in your actual values

# Supabase API URL
# For local development: http://localhost:54321
# For production: https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321

# Supabase Anon Key (public, safe to expose)
# Get this from Supabase project settings
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Supabase Service Role Key (private, NEVER expose in production)
# Get this from Supabase project settings
# Only use this in backend/API routes with proper security
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Google OAuth Configuration (optional, for Phase 5)
# Get these from Google Cloud Console
# NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=your_client_id_here
# GOOGLE_OAUTH_CLIENT_SECRET=your_client_secret_here

# Application Environment
NODE_ENV=development

# Letta Configuration
# Get these from your Letta Cloud Dashboard
LETTA_API_KEY=your_letta_api_key
LETTA_PROJECT_ID=your_project_id

# Agent
PLAYGROUND_AGENT_ID=your_playground_agent_id
