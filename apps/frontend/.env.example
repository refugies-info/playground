# Supabase Configuration
# For local development: http://127.0.0.1:54321
# For production: https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Supabase Anon Key (public, safe to expose)
# Get this from Supabase project settings or `supabase start` output
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Supabase Service Role Key (private, NEVER expose in client-side code)
# Get this from Supabase project settings or `supabase start` output
# Only use this in backend/API routes with proper security
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Application Environment
NODE_ENV=development

# Ingestion
MAX_PENDING_AUDITS=50

# Letta Configuration
# Get these from your Letta Cloud Dashboard
LETTA_API_KEY=your_letta_api_key
LETTA_PROJECT_ID=your_project_id

# Agent
PLAYGROUND_AGENT_ID=your_playground_agent_id

# Refugies.info Integration (Preview & Publication)
# For local dev: http://localhost:3000
# For staging: https://staging.refugies.info
RI_BASE_URL=http://localhost:3000
# Public URL for client-side preview (translation preview)
NEXT_PUBLIC_RI_BASE_URL=http://localhost:3000
# Shared secret for webhook authentication
RI_WEBHOOK_SECRET=your_webhook_secret_here

# Legacy - will be replaced by RI_BASE_URL logic
NEXT_PUBLIC_PREVIEW_URL=http://localhost:3000/dispositif/preview

# Vercel Cron Secret — Vercel auto-sends Authorization: Bearer <CRON_SECRET> on cron triggers
# CRON_SECRET=your_cron_secret_here
