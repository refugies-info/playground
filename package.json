{
  "name": "content-playground",
  "version": "0.1.0",
  "description": "Editorial workflow platform for Refugies.info content management",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "prepare": "husky",
    "build": "turbo build",
    "check:outdated": "pnpx taze -r --maturity-period",
    "check:types": "turbo check:types",
    "test": "turbo test",
    "clean:branches": "pnpx git-removed-branches --prune --force",
    "dev": "turbo dev dev:workflow",
    "dev:workflow": "workflow inspect runs --web",
    "format": "biome format --write .",
    "knip": "knip",
    "lint": "biome check --write .",
    "security:scan:js": "cve-lite . --fail-on high",
    "validate:docs": "tsx scripts/validate-docs.ts",
    "validate:corpus": "tsx scripts/validate-corpus.ts",
    "validate": "pnpm validate:docs && pnpm validate:corpus && pnpm knip",
    "list:agents": "tsx scripts/list-agents.ts",
    "letta:up": "docker compose -f docker-compose.letta.yml up -d",
    "letta:down": "docker compose -f docker-compose.letta.yml down",
    "letta:logs": "docker compose -f docker-compose.letta.yml logs -f",
    "letta:pull": "docker compose -f docker-compose.letta.yml exec ollama ollama pull qwen2.5:0.5b && docker compose -f docker-compose.letta.yml exec ollama ollama pull nomic-embed-text",
    "letta:sync": "docker compose -f docker-compose.letta.yml restart letta && sleep 10",
    "letta:init": "pnpm letta:up && pnpm letta:pull && pnpm letta:sync && LETTA_BASE_URL=http://localhost:8283 pnpm agents:create-local",
    "agents:create-local": "tsx scripts/create-local-agents.ts",
    "db:migrate": "supabase migration up",
    "di:ingest": "tsx scripts/ingest-di.ts",
    "di:extract": "tsx scripts/extract-random-records.ts",
    "di:cron": "dotenv -e .env -- sh -c 'curl -s -X GET http://localhost:3001/api/cron/di-ingestion -H \"Authorization: Bearer $CRON_SECRET\" | jq .'",
    "gen:types": "pnpm --filter @playground/supabase gen:types",
    "storybook": "pnpm --filter @playground/storybook storybook",
    "storybook:publish": "dotenv -e .env -- pnpm --filter @playground/storybook chromatic",
    "storybook:test": "pnpm --filter @playground/storybook test",
    "force:metadata": "tsx scripts/force-metadata-reports.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.6",
    "@playground/shared-types": "workspace:*",
    "@playground/supabase": "workspace:*",
    "@refugies-info/di": "workspace:*",
    "@workflow/cli": "4.2.10",
    "@workflow/next": "4.0.10",
    "commander": "^14.0.3",
    "cve-lite-cli": "1.34.0",
    "dotenv": "^17.4.2",
    "husky": "^9.1.7",
    "knip": "^6.41.0",
    "lint-staged": "^16.4.0",
    "postcss": "8.5.28",
    "tsx": "^4.23.15",
    "turbo": "^2.11.8"
  },
  "lint-staged": {
    "**/*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
      "biome check --write"
    ]
  },
  "dependencies": {
    "gray-matter": "^4.0.3"
  }
}
