# .env.production.example
#
# Production env vars for one-off scripts (e.g. republish:prod).
# Copy to .env.production and fill in real values.
#
# Usage:
#   dotenv -e .env.production -- pnpm republish:prod
#
# ⚠️  NEVER commit .env.production — it contains secrets.

# ── Supabase (production project) ────────────────────────────────────────────
# Get these from Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://qqoijeiqfdpcyxyheahv.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_production_service_role_key

# ── Refugies.info (production) ───────────────────────────────────────────────
RI_BASE_URL=https://refugies.info
RI_WEBHOOK_SECRET=your_production_webhook_secret
