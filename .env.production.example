# .env.production.example
#
# Production env vars for one-off scripts (e.g. force:metadata).
# Copy to .env.production and fill in real values.
#
# Usage:
#   pnpm force:metadata --prod
#
# ⚠️  NEVER commit .env.production — it contains secrets.

# ── Supabase (production project) ────────────────────────────────────────────
# Get these from Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_production_service_role_key

# ── Letta AI ─────────────────────────────────────────────────────────────────
# Get these from Letta Cloud Dashboard
LETTA_API_KEY=your_letta_api_key
LETTA_PROJECT_ID=your_letta_project_id
PLAYGROUND_AGENT_ID=your_metadata_agent_id

# ── Refugies.info (production) ───────────────────────────────────────────────
RI_BASE_URL=https://refugies.info
RI_WEBHOOK_SECRET=your_production_webhook_secret

# ── Slack notifications (publication) ────────────────────────────────────────
# #logs-bomo : fiches RCO publiées | #dev : erreurs de publication
SLACK_WEBHOOK_LOGS_BOMO=your_production_logs_bomo_webhook
SLACK_WEBHOOK_DEV=your_production_dev_webhook
# URL de base de l'éditeur BOMO (lien /documents/{workflowId} dans Slack)
BOMO_BASE_URL=your_production_bomo_url
