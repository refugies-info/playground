# Environment Variables Template
# Copy this file to .env and fill in your actual values

# =============================================================================
# Supabase
# =============================================================================
# For local dev: http://127.0.0.1:54321
# For production: https://your-project.supabase.co
SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# =============================================================================
# Letta AI — pick ONE of the 3 modes below (uncomment one block, comment others)
# Full guide: documentation/ai/local-letta-dev.md
# =============================================================================
# LETTA_API_KEY + LETTA_PROJECT_ID are used by the cloud modes (A & B) only;
# the local Ollama mode (C) ignores them (server runs auth-less).
LETTA_API_KEY=your_letta_api_key_here
LETTA_PROJECT_ID=your_project_id_here

# --- A) CLOUD + FREE model (letta/letta-free) -- recommended for dev ----------
# Free quota, prod-grade quality, no paid tokens. Internet required.
# Create the agents on Letta Cloud with model "letta/letta-free", then paste IDs.
# Rate-limited (HTTP 429 -> workflow steps auto-retry).
LETTA_BASE_URL=https://api.letta.com
PLAYGROUND_AGENT_ID=your_free_playground_agent_id
METADATA_AGENT_ID=your_free_metadata_agent_id
# Translation agents have a hardcoded PROD-premium fallback in code — pin them to
# a free agent or RU/UK/AR translation will consume paid tokens.
LETTA_AGENT_AR=your_free_agent_id
LETTA_AGENT_UK=your_free_agent_id
LETTA_AGENT_RU=your_free_agent_id

# --- B) CLOUD + PROD agents (Claude premium — CONSUMES paid tokens) -----------
# Full production behavior + real translation quality. Use sparingly.
#LETTA_BASE_URL=https://api.letta.com
#PLAYGROUND_AGENT_ID=your_prod_playground_agent_id
#LETTA_AGENT_AR=your_prod_ar_agent_id
#LETTA_AGENT_UK=your_prod_uk_agent_id
#LETTA_AGENT_RU=your_prod_ru_agent_id

# --- C) LOCAL Ollama (self-hosted, offline) ----------------------------------
# Free + private, low quality. Needs a tool-capable model (qwen2.5:0.5b; NOT
# gemma3:1b). letta/letta-free does NOT work here (401 at inference).
# Start: pnpm letta:init   Create agents: pnpm agents:create-local
#LETTA_BASE_URL=http://localhost:8283
#PLAYGROUND_AGENT_ID=your_local_playground_agent_id
#METADATA_AGENT_ID=your_local_metadata_agent_id
# METADATA_AGENT_ID falls back to PLAYGROUND_AGENT_ID if unset.

# =============================================================================
# Data Inclusion API
# =============================================================================
# Get API key from: https://api.data.inclusion.gouv.fr/
DI_BASE_URL=https://api-staging.data.inclusion.gouv.fr
DI_API_KEY=your_di_api_key_here
# Optional: pagination size for API requests (default: 100, max: 10000)
# DI_PAGE_SIZE=100
# Maximum size of editorial backlog before throttling Letta processing
MAX_EDITORIAL_BACKLOG=1

# =============================================================================
# Vercel Cron
# =============================================================================
# Vercel auto-sends Authorization: Bearer <CRON_SECRET> on cron triggers
# CRON_SECRET=your_cron_secret_here

# =============================================================================
# Refugies.info Integration
# =============================================================================
# For local dev: http://localhost:3000
# For staging: https://staging.refugies.info
RI_BASE_URL=http://localhost:3000
RI_WEBHOOK_SECRET=your_webhook_secret_here
NEXT_PUBLIC_PREVIEW_URL=http://localhost:3000/dispositif/preview

# =============================================================================
# Slack Notifications (publication)
# =============================================================================
# Incoming Webhooks — notifications de publication RCO (fire-and-forget).
# #logs-bomo : fiches publiées avec succès
# #dev       : erreurs de publication
SLACK_WEBHOOK_LOGS_BOMO=
SLACK_WEBHOOK_DEV=
# URL de base de l'éditeur BOMO — lien direct /documents/{workflowId} dans Slack
BOMO_BASE_URL=http://localhost:3001

# =============================================================================
# Application
# =============================================================================
NODE_ENV=development
# LOG_LEVEL=info

# Enable debug panel in production (default: false in prod, true in dev)
# Set to "true" to show the debug panel (Alt+Shift+D) on any environment
# NEXT_PUBLIC_DEBUG_PANEL=true

# =============================================================================

# =============================================================================
# Airtable (Translation Billing Tracking)
# =============================================================================
# Used by addTradToAirtableStep to track translation word counts for billing.
# Get your API token from: https://airtable.com/create/tokens
AIRTABLE_TOKEN=your_airtable_token_here
# Base ID for the translation tracking base (starts with "app...")
AIRTABLE_BASE_TRAD=your_airtable_base_id_here

# =============================================================================
# MongoDB
# =============================================================================
# MongoDB connection URI for legacy data
# For local dev: mongodb://127.0.0.1:27017/your_database_name
MONGODB_URI=mongodb_url
