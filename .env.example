# Environment Variables Template
# Copy this file to .env and fill in your actual values

# =============================================================================
# Supabase
# =============================================================================
# For local dev: http://127.0.0.1:54321
# For production: https://your-project.supabase.co
SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# =============================================================================
# Letta AI
# =============================================================================
# Get these from your Letta Cloud Dashboard
LETTA_API_KEY=your_letta_api_key_here
LETTA_PROJECT_ID=your_project_id_here
PLAYGROUND_AGENT_ID=your_playground_agent_id

# =============================================================================
# Data Inclusion API
# =============================================================================
# Get API key from: https://api.data.inclusion.gouv.fr/
DI_BASE_URL=https://api-staging.data.inclusion.gouv.fr
DI_API_KEY=your_di_api_key_here
# Optional: pagination size for API requests (default: 100, max: 10000)
# DI_PAGE_SIZE=100
MAX_PENDING_AUDITS=50

# =============================================================================
# Vercel Cron
# =============================================================================
# Vercel auto-sends Authorization: Bearer <CRON_SECRET> on cron triggers
# CRON_SECRET=your_cron_secret_here

# =============================================================================
# Refugies.info Integration
# =============================================================================
# For local dev: http://localhost:3000
# For staging: https://staging.refugies.info
RI_BASE_URL=http://localhost:3000
RI_WEBHOOK_SECRET=your_webhook_secret_here
NEXT_PUBLIC_PREVIEW_URL=http://localhost:3000/dispositif/preview

# =============================================================================
# Application
# =============================================================================
NODE_ENV=development
# LOG_LEVEL=info

# Enable debug panel in production (default: false in prod, true in dev)
# Set to "true" to show the debug panel (Alt+Shift+D) on any environment
# NEXT_PUBLIC_DEBUG_PANEL=true

# =============================================================================
# Scripts
# =============================================================================
# Password for seeded users (admin, editor, translators).
# If not set, a secure random password will be generated and printed to the console.
SEED_USER_PASSWORD=password123_here

# =============================================================================
# MongoDB
# =============================================================================
# MongoDB connection URI for legacy data
# For local dev: mongodb://127.0.0.1:27017/your_database_name
MONGODB_URI=mongodb_url
