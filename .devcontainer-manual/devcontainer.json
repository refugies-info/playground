{
  "name": "Refugiés Info Playground",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-20-bullseye",
  "postCreateCommand": "npm i -g pnpm turbo @letta-ai/letta-code && pnpm install",
  "mounts": [
    "source=${localEnv:HOME}/.gemini,target=/home/node/.gemini,type=bind",
    "source=${localEnv:HOME}/.letta,target=/home/node/.letta,type=bind",
    "source=${localEnv:HOME}/.ssh,target=/home/node/.ssh,type=bind,readonly"
  ],
  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "customizations": {
    "vscode": {
      "settings": {
        "editor.defaultFormatter": "biomejs.biome",
        "editor.formatOnSave": true
      },
      "extensions": [
        "biomejs.biome",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "tamasfe.even-better-toml",
        "redhat.vscode-yaml",
        "mikestead.dotenv",
        "unifiedjs.vscode-mdx",
        "yzhang.markdown-all-in-one",
        "eamodio.gitlens",
        "github.vscode-pull-request-github"
      ]
    }
  },
  "remoteUser": "node",
  "workspaceFolder": "/workspaces/playground"
}
