{
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts"],
      "project": ["scripts/*.ts"]
    },
    "packages/shared": {
      "project": ["src/**/*.ts"]
    },
    "packages/ui": {
      "project": ["src/**/*.ts", "src/**/*.tsx"]
    },
    "apps/frontend": {
      "project": ["src/**/*.ts", "src/**/*.tsx"]
    },
    "packages/agents": {
      "entry": ["scripts/*.ts"],
      "project": ["src/**/*.ts", "scripts/*.ts"]
    },
    "packages/rco": {
      "entry": ["scripts/*.ts"],
      "project": ["src/**/*.ts", "scripts/*.ts"]
    }
  },
  "ignore": [
    "node_modules",
    "dist",
    "build",
    ".next",
    "coverage",
    ".turbo",
    "packages/rco/.velite",
    "packages/rco/src/lheo-types.ts",
    "packages/mongo/scripts/test-connection.ts",
    "packages/agents/scripts/convert-dispositifs.ts"
  ],
  "ignoreDependencies": ["husky", "tsx", "zod", "velite"]
}
