{
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts"],
      "project": ["scripts/*.ts"]
    },
    "packages/shared": {
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["pino-pretty"]
    },
    "packages/ui": {
      "project": ["src/**/*.ts", "src/**/*.tsx"],
      "ignoreDependencies": ["@storybook/react", "storybook", "tailwindcss"]
    },
    "apps/frontend": {
      "project": ["src/**/*.ts", "src/**/*.tsx"],
      "ignoreDependencies": ["@playground/agents", "flag-icons"]
    },
    "apps/storybook": {
      "ignoreDependencies": ["@playground/ui", "@storybook/react"]
    }
  },
  "ignoreDependencies": ["tsx", "zod"]
}
