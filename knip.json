{
  "workspaces": {
    "packages/shared": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/ui": {
      "project": ["src/**/*.ts", "src/**/*.tsx"]
    },
    "apps/frontend": {
      "entry": ["src/lib/supabase.ts", "src/lib/auth.ts"],
      "project": ["src/**/*.ts", "src/**/*.tsx"]
    }
  },
  "ignore": ["node_modules", "dist", "build", ".next", "coverage", ".turbo"],
  "ignoreDependencies": ["husky"]
}
