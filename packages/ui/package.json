{
  "name": "@playground/ui",
  "version": "0.1.0",
  "description": "Refugies.info UI component library",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./primitives": {
      "import": "./dist/primitives/index.js",
      "types": "./dist/primitives/index.d.ts"
    },
    "./forms": {
      "import": "./dist/forms/index.js",
      "types": "./dist/forms/index.d.ts"
    },
    "./overlays": {
      "import": "./dist/overlays/index.js",
      "types": "./dist/overlays/index.d.ts"
    },
    "./composites": {
      "import": "./dist/composites/index.js",
      "types": "./dist/composites/index.d.ts"
    },
    "./icons": {
      "import": "./src/icons.ts",
      "types": "./src/icons.ts"
    },
    "./styles/globals.css": "./src/styles/globals.css"
  },
  "scripts": {
    "build": "tsc",
    "check:types": "tsc --noEmit",
    "sync:icons": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/sync-dsfr-icons.ts",
    "postinstall": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/sync-dsfr-icons.ts"
  },
  "dependencies": {
    "@gouvfr/dsfr": "^1.15.2",
    "@playground/shared-types": "workspace:*",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@remixicon/react": "^4.9.0",
    "@tanstack/react-table": "^8.21.3",
    "@vladyoslav/drawer": "^0.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^0.562.0",
    "react": "^19.2.8",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.8",
    "tailwind-merge": "2.5.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
